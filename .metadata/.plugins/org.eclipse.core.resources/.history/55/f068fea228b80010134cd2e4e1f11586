package com.recipeapp.controller;

import com.recipeapp.dto.ApiResponse;
import com.recipeapp.entity.Recipe;
import com.recipeapp.entity.Comment;
import com.recipeapp.repository.RecipeRepository;
import com.recipeapp.repository.CommentRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/recipes")
@CrossOrigin(origins = "http://localhost:5173", allowCredentials = "true")
public class RecipeController {

    @Autowired private RecipeRepository recipeRepo;
    @Autowired private CommentRepository commentRepo;

    // ✅ Download endpoint — increments downloads
    @PostMapping("/{id}/download")
    public ApiResponse<Recipe> incrementDownload(@PathVariable Long id) {
        Recipe recipe = recipeRepo.findById(id).orElse(null);
        if (recipe == null) return new ApiResponse<>(false, "Recipe not found!", null);

        recipe.setDownloads(recipe.getDownloads() + 1);
        recipeRepo.save(recipe);
        return new ApiResponse<>(true, "Download count updated!", recipe);
    }

    // ✅ Add comment endpoint
    @PostMapping("/{id}/comments")
    public ApiResponse<Comment> addComment(@PathVariable Long id, @RequestBody Comment commentReq) {
        Recipe recipe = recipeRepo.findById(id).orElse(null);
        if (recipe == null) return new ApiResponse<>(false, "Recipe not found!", null);

        Comment comment = new Comment();
        comment.setRecipeId(id);
        comment.setUser(commentReq.getUser());
        comment.setText(commentReq.getText());
        comment.setDate(new java.util.Date());
        commentRepo.save(comment);

        return new ApiResponse<>(true, "Comment added successfully!", comment);
    }
}
