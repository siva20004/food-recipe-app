package com.recipeapp.controller;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;
import com.recipeapp.dto.*;
import com.recipeapp.entity.*;
import com.recipeapp.repository.ChefRepository;
import com.recipeapp.service.AuthService;
import com.recipeapp.service.EmailService;
import java.util.List;
import java.util.Optional;
import java.util.stream.Collectors;

@RestController
@RequestMapping("/api/auth")
@CrossOrigin(origins = "http://localhost:5173", allowCredentials = "true")
public class AuthController {

    @Autowired
    private AuthService authService;

    @Autowired
    private ChefRepository chefRepo;

    @Autowired
    private EmailService emailService;

    // 🧾 SIGNUP
    @PostMapping("/signup")
    public ApiResponse<Object> signup(@RequestBody SignupRequest req) {
        try {
            Object user = authService.registerUser(req);
            return new ApiResponse<>(true, "Signup successful!", user);
        } catch (IllegalArgumentException e) {
            return new ApiResponse<>(false, e.getMessage(), null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Signup failed: " + e.getMessage(), null);
        }
    }

    // 🔐 LOGIN
    @PostMapping("/login")
    public ApiResponse<Object> login(@RequestBody LoginRequest req) {
        try {
            Object loginResult = authService.loginUser(req);
            return new ApiResponse<>(true, "Login successful!", loginResult);
        } catch (IllegalArgumentException e) {
            return new ApiResponse<>(false, e.getMessage(), null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Login failed: " + e.getMessage(), null);
        }
    }

    // 🚪 LOGOUT
    @PostMapping("/logout")
    public ApiResponse<String> logout() {
        return new ApiResponse<>(true, "Logout successful!", null);
    }

    // 👨‍🍳 Get All Pending Chefs for Admin
    @GetMapping("/chefs")
    public ApiResponse<List<Chef>> getPendingChefs() {
        List<Chef> pendingChefs = chefRepo.findAll().stream()
                .filter(c -> "PENDING".equalsIgnoreCase(c.getStatus()))
                .collect(Collectors.toList());
        return new ApiResponse<>(true, "Fetched pending chefs successfully!", pendingChefs);
    }

    // ✅ Approve Chef
    @PutMapping("/approveChef/{id}")
    public ApiResponse<String> approveChef(@PathVariable Long id) {
        try {
            Optional<Chef> chefOpt = chefRepo.findById(id);
            if (chefOpt.isEmpty()) {
                return new ApiResponse<>(false, "Chef not found!", null);
            }

            Chef chef = chefOpt.get();
            if (chef.isApproved() || "APPROVED".equalsIgnoreCase(chef.getStatus())) {
                return new ApiResponse<>(false, "Chef already approved!", null);
            }

            chef.setApproved(true);
            chef.setRejected(false);
            chef.setStatus("APPROVED");
            chefRepo.save(chef);

            // 📨 Send approval email
            try {
                String subject = "Chef Account Approved – Cookbook Cloud 🍳";
                String text = "Dear " + chef.getFullName() + ",\n\n"
                        + "🎉 Congratulations! Your chef account has been approved.\n"
                        + "You can now log in and start uploading your recipes.\n\n"
                        + "Best wishes,\nCookbook Cloud Team";
                emailService.sendMail(chef.getEmail(), subject, text);
            } catch (Exception mailEx) {
                System.err.println("⚠️ Failed to send approval email: " + mailEx.getMessage());
            }

            return new ApiResponse<>(true, "Chef approved successfully!", null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Error approving chef: " + e.getMessage(), null);
        }
    }

    // ❌ Reject Chef
    @PutMapping("/rejectChef/{id}")
    public ApiResponse<String> rejectChef(@PathVariable Long id) {
        try {
            Optional<Chef> chefOpt = chefRepo.findById(id);
            if (chefOpt.isEmpty()) {
                return new ApiResponse<>(false, "Chef not found!", null);
            }

            Chef chef = chefOpt.get();
            if ("REJECTED".equalsIgnoreCase(chef.getStatus())) {
                return new ApiResponse<>(false, "Chef already rejected!", null);
            }

            chef.setApproved(false);
            chef.setRejected(true);
            chef.setStatus("REJECTED");
            chefRepo.save(chef);

            // 📨 Send rejection email
            try {
                String subject = "Chef Account Rejected – Cookbook Cloud ❌";
                String text = "Dear " + chef.getFullName() + ",\n\n"
                        + "We regret to inform you that your chef registration has been rejected.\n"
                        + "You may contact support or apply again later.\n\n"
                        + "Regards,\nCookbook Cloud Team";
                emailService.sendMail(chef.getEmail(), subject, text);
            } catch (Exception mailEx) {
                System.err.println("⚠️ Failed to send rejection email: " + mailEx.getMessage());
            }

            return new ApiResponse<>(true, "Chef rejected successfully!", null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Error rejecting chef: " + e.getMessage(), null);
        }
    }

    // 🧑‍💼 Update Profile (User, Chef, Admin)
    @PutMapping("/updateProfile/{username}")
    public ApiResponse<Object> updateProfile(@PathVariable String username, @RequestBody SignupRequest req) {
        try {
            Object updatedUser = authService.updateProfile(username, req);
            return new ApiResponse<>(true, "Profile updated successfully!", updatedUser);
        } catch (IllegalArgumentException e) {
            return new ApiResponse<>(false, e.getMessage(), null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Error updating profile: " + e.getMessage(), null);
        }
    }

    // 🔐 Change Password
    @PutMapping("/change-password")
    public ApiResponse<Object> changePassword(@RequestBody LoginRequest req) {
        try {
            boolean updated = authService.changePassword(req);
            if (updated)
                return new ApiResponse<>(true, "Password updated successfully!", null);
            else
                return new ApiResponse<>(false, "Password update failed!", null);
        } catch (IllegalArgumentException e) {
            return new ApiResponse<>(false, e.getMessage(), null);
        } catch (Exception e) {
            return new ApiResponse<>(false, "Error updating password: " + e.getMessage(), null);
        }
    }
}
