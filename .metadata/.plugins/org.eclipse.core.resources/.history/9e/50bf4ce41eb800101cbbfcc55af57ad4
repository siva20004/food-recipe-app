package com.recipeapp.controller;

import com.recipeapp.dto.ApiResponse;
import com.recipeapp.entity.*;
import com.recipeapp.repository.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import java.util.Optional;

@CrossOrigin(origins = "http://localhost:5173", allowCredentials = "true")
@RestController
@RequestMapping("/api/users")
public class ProfileController {

    @Autowired
    private UserRepository userRepo;

    @Autowired
    private ChefRepository chefRepo;

    @Autowired
    private AdminRepository adminRepo;

    // ✅ Get user profile by username (works for any role)
    @GetMapping("/{username}")
    public ApiResponse<Object> getUserProfile(@PathVariable String username) {
        Optional<User> user = userRepo.findByUsername(username);
        if (user.isPresent()) return new ApiResponse<>(true, "User profile found", user.get());

        Optional<Chef> chef = chefRepo.findByUsername(username);
        if (chef.isPresent()) return new ApiResponse<>(true, "Chef profile found", chef.get());

        Optional<Admin> admin = adminRepo.findByUsername(username);
        if (admin.isPresent()) return new ApiResponse<>(true, "Admin profile found", admin.get());

        return new ApiResponse<>(false, "User not found", null);
    }

    // ✅ Update user/chef/admin profile
    @PutMapping("/{username}")
    public ApiResponse<Object> updateProfile(@PathVariable String username, @RequestBody Object updatedProfile) {
        try {
            // Try updating User
            Optional<User> userOpt = userRepo.findByUsername(username);
            if (userOpt.isPresent()) {
                User user = userOpt.get();
                User newUser = (User) updatedProfile;
                user.setFullName(newUser.getFullName());
                user.setEmail(newUser.getEmail());
                user.setPhone(newUser.getPhone());
                userRepo.save(user);
                return new ApiResponse<>(true, "User profile updated successfully!", user);
            }

            // Try updating Chef
            Optional<Chef> chefOpt = chefRepo.findByUsername(username);
            if (chefOpt.isPresent()) {
                Chef chef = chefOpt.get();
                Chef newChef = (Chef) updatedProfile;
                chef.setFullName(newChef.getFullName());
                chef.setEmail(newChef.getEmail());
                chef.setPhone(newChef.getPhone());
                chef.setExperience(newChef.getExperience());
                chef.setProfilePic(newChef.getProfilePic());
                chefRepo.save(chef);
                return new ApiResponse<>(true, "Chef profile updated successfully!", chef);
            }

            // Try updating Admin
            Optional<Admin> adminOpt = adminRepo.findByUsername(username);
            if (adminOpt.isPresent()) {
                Admin admin = adminOpt.get();
                Admin newAdmin = (Admin) updatedProfile;
                admin.setFullName(newAdmin.getFullName());
                admin.setEmail(newAdmin.getEmail());
                admin.setPhone(newAdmin.getPhone());
                adminRepo.save(admin);
                return new ApiResponse<>(true, "Admin profile updated successfully!", admin);
            }

            return new ApiResponse<>(false, "User not found!", null);

        } catch (Exception e) {
            return new ApiResponse<>(false, "Error updating profile: " + e.getMessage(), null);
        }
    }
}
